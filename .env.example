# Postgres connection string. In production (e.g. Railway) this is injected
# for you. Locally, point it at your own Postgres instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recorder

# Where to store gzipped session blobs when not using inline DB storage
# (a mounted volume in prod, ./data locally).
BLOB_DIR=./data

# Secrets — generate strong random values for production (32+ bytes each).
#   e.g.  openssl rand -base64 32
JWT_SECRET=dev-change-me-please-32-bytes-aaaa
INGEST_TOKEN_SECRET=dev-ingest-secret-change-me-32-bytes-aaaa

# Admin login. These are seeded into the admin_users table on boot, so
# upgrading deploys keep their logins; change them here and redeploy to
# rotate credentials.
# Single admin:
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# ...or multiple admins via a JSON array (takes precedence over the pair above):
# ADMINS_CREDS=[{"email":"admin@example.com","password":"change-me"},{"email":"admin2@example.com","password":"change-me-too"}]

# Display name for the auto-created organization/project on first boot.
ORG_NAME=My Company

# Public app origin (used for cookie domain etc).
APP_ORIGIN=http://localhost:3000

# AI layer: URL of the bundled LLM service (llama.cpp, OpenAI-compatible;
# see private-multimodel-llm-service/README.md). Leave unset to disable the
# LLM intent summaries and visitor profiles (deterministic narratives still
# work). SUMMARIZER_URL is honored as a legacy alias.
# LLM_SERVICE_URL=http://summarizer.railway.internal:8080
# SUMMARIZER_MODEL_LABEL=qwen3.5-4b-q4km

# Optional: with Redis, narrative/profile processing runs through BullMQ
# workers; without it an in-process drain loop does the same work.
# REDIS_URL=redis://localhost:6379
